{
  "name": "shnei-tzdadim-app",
  "version": "1.0.0",
  "private": true,
  "description": "שני צדדים - אפליקציית יום החתונה (iOS + Android)",
  "scripts": {
    "sync-web": "node scripts/sync-web.mjs",
    "sync": "npm run sync-web && npx cap sync",
    "ios": "npm run sync && npx cap open ios",
    "android": "npm run sync && npx cap open android",
    "assets": "npx @capacitor/assets generate --iconBackgroundColor '#F6F2F4' --splashBackgroundColor '#F6F2F4' --splashBackgroundColorDark '#140F16'"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/core": "7.6.9",
    "@capacitor/filesystem": "7.1.8",
    "@capacitor/ios": "7.6.9",
    "@capacitor/share": "7.0.3",
    "@capacitor/splash-screen": "7.0.4",
    "@capacitor/status-bar": "7.0.5"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "7.6.9"
  }
}